# frozen_string_literal: true
source 'https://rubygems.org'

# Sinatra 4 runs on Rack 3. Rack 3 moved the session middleware into the
# rack-session gem, and booting `ruby app.rb` needs a Rack handler (puma) plus
# rackup. net/http, json, openssl, securerandom, and uri are in the standard
# library.
gem 'sinatra', '~> 4.0'
gem 'rack-session', '~> 2.0'
gem 'rackup', '~> 2.0'
gem 'puma', '~> 7.2'
gem 'dotenv', '~> 3.0'
